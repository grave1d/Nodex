{
  "name": "nodex-ai",
  "version": "0.3.0",
  "description": "Local OpenAI-compatible bridge that connects Notion Custom Agents to Codex.",
  "type": "module",
  "bin": {
    "nodex": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "RELEASE_NOTES_v0.3.0.md",
    "RELEASE_NOTES_v0.2.0.md",
    "nodex.config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "test:live": "npm run build && node dist/cli.js doctor --live",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "keywords": [
    "codex",
    "notion",
    "notion-ai",
    "notion-agent",
    "openai",
    "responses-api",
    "ai-agent",
    "developer-tools",
    "local-first"
  ],
  "author": "grave1d",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grave1d/Nodex.git"
  },
  "bugs": {
    "url": "https://github.com/grave1d/Nodex/issues"
  },
  "homepage": "https://github.com/grave1d/Nodex#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "better-sqlite3": "^12.4.1",
    "chokidar": "^4.0.3",
    "fastify": "^5.6.2",
    "pino": "^9.14.0",
    "undici": "^7.28.0",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.13"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  }
}
